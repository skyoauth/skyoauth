{
  "fixture_version": 1,
  "kind": "local_socket_path",
  "status": "proposed",
  "description": "Known answers for the checks of the deployment-local transport's socket path: the service's own rules for its socket file (service/src/local_transport, module docs \"The socket file\", steps 1, 2, 5 and 8, and socket.rs: write_safe, check_directory, check_ancestors, the final check) and the operator client's copy of them (skyoauth_operator::local::check_socket), which must agree on every tree. Each case is a tree of entries created in a fresh case root, the path to check relative to it, and the expected outcome: accept, or the class of the first check that refuses it. The operator's test target `operator` (operator/tests/local_path) runs every case through check_socket; the `pg` target of skyoauth-scenarios (tests/harness/socket_path_fixture.rs) builds the same trees and binds the service's LocalTransport at the path, whose result must be the outcome's `bind` (accept iff the bind succeeds where the outcome's bind is ok, and the socket the bind makes is then a socket of the service UID with mode exactly 0600). Inferred: no contract text fixes these rules or the client's trust set; the service's code is the source, and status stays \"proposed\" until a contract states them. Modes are octal strings with the leading zero; the socket's mode is set after its owner, so a set-ID bit survives the owner's change.",
  "socket_mode": "0600",
  "max_symlinks": 40,
  "max_socket_path_bytes": {
    "linux": 107,
    "other_unix": 103
  },
  "roles": {
    "service": "The service UID: the socket's expected owner, SocketExpectations.owner_uid on the client, the service UID of the bind on the service. Never root.",
    "root": "UID 0.",
    "other": "A UID that is neither root nor the service UID."
  },
  "trust": {
    "service_or_root": "The client's AncestorTrust::ServiceOrRoot (an inferred pick: the usual case). The service's bind for its own effective UID (LocalTransport::new(.., None)), run as the service UID: it trusts root and the service UID with the directories.",
    "root_only": "The client's AncestorTrust::RootOnly (the stricter option). The service's bind by root for another service UID (LocalTransport::new(.., Some(service UID))): it trusts root alone with the directories, and the socket's directory must be root's."
  },
  "case_root": "Each case runs in a fresh directory, the case root, owned by root with mode 0755, under the system's temporary directory with its symbolic links resolved (macOS's lives under /var, a link to private/var), so a case's own links are the only ones its lookup follows; those directories are all root's or the running UID's and not writable by group or others unless sticky. `path` and every entry's `path` are relative to the case root; a symbolic link's `target` is used as is, but for a leading `$ROOT`, which stands for the case root's absolute path. Entries are created in their order, each with its owner (lchown, not followed) and then its mode (not for a symbolic link). A `symlink_chain` of `links` links puts its first link at `path` and link i (1 to links-1) at `path` followed by `.i`, each pointing to the next by its name, and the last one to `target`. A case with `pad` extends the last component of `path` with `p` until the absolute path is exactly the platform's max_socket_path_bytes (`limit`) or one byte more (`over_limit`); an entry at the same `path` is padded the same way. Who can run what: a process that is not root cannot give an entry to root or to the other role, nor own the case root as root, so it runs only the cases whose entries are all the service's (as its own UID), and of those under root_only only the ones whose outcome is invalid_path, too_long or unsafe_directory (decided before the walk reaches the case root). The service's root_only bind needs root; as root, its service_or_root bind runs in a child process as the service UID (a local user the harness is given). A case a reader cannot run is skipped with a printed NOTICE, never passed. The cases follow Linux's kernel, which follows up to 40 symbolic links in one lookup, as the walk does; a kernel that follows fewer (32 on the BSDs and macOS) fails the lookup of an accept case's longer chain itself, so there the client's verdict is lookup (with the platform's error kind), noted with a printed NOTICE.",
  "outcomes": [
    {
      "expect": "accept",
      "bind": "ok",
      "applies_when": "Every check passes: the client connects. The service binds (a stale socket of its UID at the path is replaced), and its socket is then a socket of the service UID with mode exactly 0600."
    },
    {
      "expect": "invalid_path",
      "bind": "InvalidPath",
      "applies_when": "The path ends in / or /., or has no parent directory or no name (it ends in ..)."
    },
    {
      "expect": "too_long",
      "bind": "PathTooLong",
      "applies_when": "The path is longer than max_socket_path_bytes for the platform."
    },
    {
      "expect": "unsafe_directory",
      "bind": "UnsafeDirectory",
      "applies_when": "The socket's directory, its path not followed, is a symbolic link or not a directory, has an owner the trust set does not hold, or is writable by group or others without the sticky bit."
    },
    {
      "expect": "unsafe_ancestor",
      "bind": "UnsafeAncestor",
      "applies_when": "A directory the lookup of the socket's directory looks an entry or .. up in (the root directory included, symbolic links followed as the kernel does) has an owner the trust set does not hold or is writable by group or others without the sticky bit; or a symbolic link on the way, in a directory writable by group or others (so sticky), has an owner the trust set does not hold."
    },
    {
      "expect": "too_many_symlinks",
      "bind": "Io",
      "applies_when": "The lookup of the socket's directory follows more than max_symlinks symbolic links."
    },
    {
      "expect": "lookup",
      "bind": "Io",
      "applies_when": "A lookup on the way to the socket's directory fails: a missing entry (io_kind NotFound) or a file where a directory should be (io_kind NotADirectory). The case's io_kind is the error's kind on both sides."
    },
    {
      "expect": "missing",
      "bind": "ok",
      "applies_when": "Nothing is at the socket path: the client has nothing to connect to; the service creates its socket there."
    },
    {
      "expect": "not_a_socket",
      "bind": "PathOccupied",
      "applies_when": "The socket path, not followed, holds a file, a directory or a symbolic link (to a socket or to nothing)."
    },
    {
      "expect": "wrong_owner",
      "bind": "PathOccupied",
      "applies_when": "The socket path holds a socket whose owner is not the service UID."
    },
    {
      "expect": "wrong_mode",
      "bind": "ok",
      "applies_when": "The socket path holds a socket of the service UID whose permission bits (set-ID and sticky bits included) are not exactly 0600: the client refuses it; the service replaces it, as a stale socket of its UID, with one of mode 0600."
    }
  ],
